{
    "name": "silviosln/arbor-router",
    "description": "Framework-agnostic file-system based routing library for PHP, inspired by Next.js App Router.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "router",
        "routing",
        "filesystem",
        "file-system",
        "nextjs",
        "app-router",
        "php"
    ],
    "authors": [
        {
            "name": "Silvio Nascimento"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Arbor\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arbor\\Router\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}